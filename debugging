-- // Helper functions (copied from Obsidian)
local createInstance = function(className, properties)
    local inst = Instance.new(className)
    for k, v in pairs(properties or {}) do inst[k] = v end
    return inst
end

local regTheme = function(instance, callback)
    table.insert(ObsidianLib.ThemeConnections, function()
        local success, hasParent = pcall(function() return instance and instance.Parent end)
        if success and hasParent then
            callback()
            return true
        end
        return false
    end)
    callback()
end

local UpdateThemeAccent = function(newColor)
    Theme.Accent = newColor
    local alive = {}
    for i = 1, #ObsidianLib.ThemeConnections do
        local func = ObsidianLib.ThemeConnections[i]
        if type(func) == 'function' then
            local s, res = pcall(func)
            if s and res ~= false then table.insert(alive, func) end
        end
    end
    ObsidianLib.ThemeConnections = alive
end

local ApplySelectedTheme = function(themeName)
    local targetTheme = Themes[themeName]
    if not targetTheme then return end
    for k, v in pairs(targetTheme) do Theme[k] = v end
    local alive = {}
    for i = 1, #ObsidianLib.ThemeConnections do
        local func = ObsidianLib.ThemeConnections[i]
        if type(func) == 'function' then
            local s, res = pcall(func)
            if s and res ~= false then table.insert(alive, func) end
        end
    end
    ObsidianLib.ThemeConnections = alive
end

RunService.RenderStepped:Connect(function()
    if ObsidianLib.RainbowAccent then
        local hue = tick() * (ObsidianLib.RainbowSpeed / 100) % 1
        UpdateThemeAccent(Color3.fromHSV(hue, 1, 1))
    end
end)

local GetDarkerColor = function(color, factor)
    local h, s, v = Color3.toHSV(color)
    return Color3.fromHSV(h, s, math.clamp(v * factor, 0, 1))
end

